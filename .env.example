# ── Copie este arquivo para .env e ajuste os valores ─────────────────────────
# cp .env.example .env

# PostgreSQL
POSTGRES_DB=logicore
POSTGRES_USER=logicore
POSTGRES_PASSWORD=logicore
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
SPRING_PROFILES_ACTIVE=development
BACKEND_PORT=8080
JWT_SECRET=logicore-dev-secret-change-in-production-min-256bit-key
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
FRONTEND_PORT=5173

# pgAdmin (profile: tools)
PGADMIN_EMAIL=admin@logicore.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
